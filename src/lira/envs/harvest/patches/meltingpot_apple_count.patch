 local DensityRegrow = class.Class(component.Component)
 
+-- ResourceStats mirrors the live apple stock into each avatar observation.
+-- It is instrumentation only; it does not alter transitions or rewards.
+local ResourceStats = class.Class(component.Component)
+
+function ResourceStats:__init__(kwargs)
+  kwargs = args.parse(kwargs, {{'name', args.default('ResourceStats')}})
+  ResourceStats.Base.__init__(self, kwargs)
+end
+
+function ResourceStats:reset()
+  self.apple_count = 0
+end
+
+function ResourceStats:registerUpdaters(updaterRegistry)
+  local function updateStats()
+    self.apple_count = self.gameObject.simulation:getGroupCount('apples')
+  end
+  updaterRegistry:registerUpdater{updateFn = updateStats, priority = 5}
+end
+
